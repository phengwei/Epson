<Project>
  <PropertyGroup>
    <WebPublishMethod>ZipDeploy</WebPublishMethod>
    <PublishProvider>AzureWebSite</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>https://epson-asia.azurewebsites.net</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <ProjectGuid>9bdad106-3f77-46fd-9e38-3cc4fa06bf99</ProjectGuid>
    <PublishUrl>https://epson-asia.scm.azurewebsites.net/</PublishUrl>
    <UserName>$epson-asia</UserName>
    <_SavePWD>true</_SavePWD>
  </PropertyGroup>
</Project>